#!/bin/bash
# TVBox 中转 —— spider-hub 启动脚本
#
# 严格遵循 fnOS 应用生命周期约定（对照 netwatch / fnm3u8dl）：
#   main start   启动
#   main stop    停止
#   main status  运行中 exit 0 / 已停止 exit 3
#   其他参数     exit 1
#
# status 的退出码是 fnOS 判断"要不要启动"的唯一依据。
# 之前写成 `status && echo running || echo stopped` 会让退出码恒为 0，
# fnOS 认为进程已在运行 → 永不启动 → 网关连不到 socket → 502 Bad Gateway。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP="${TRIM_APPDEST}"
PORT=8098
SOCK="${APP}/tvboxhub.sock"

mkdir -p "${TRIM_PKGVAR}"
export TRIM_PKGVAR="${TRIM_PKGVAR}"    # 之前写成 TRM_PKGVAR（少一个 I），子进程拿不到

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

# ── JRE 选择：包里同时带 x64 / arm64 两套（jlink 裁剪过，各 46~47MB）──
# ui/jre 是早期单架构包的名字，保留兜底，方便老安装目录直接覆盖升级。
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64|amd64)   JRE_DIR="jre-x64" ;;
    aarch64|arm64)  JRE_DIR="jre-arm64" ;;
    *)              JRE_DIR="" ;;
esac
JAVA=""
if [ -n "$JRE_DIR" ] && [ -x "${APP}/ui/${JRE_DIR}/bin/java" ]; then
    JAVA="${APP}/ui/${JRE_DIR}/bin/java"
fi
[ -n "$JAVA" ] || [ ! -x "${APP}/ui/jre/bin/java" ] || JAVA="${APP}/ui/jre/bin/java"
[ -n "$JAVA" ] || JAVA="$(command -v java 2>/dev/null)"
log_msg "arch=${ARCH} jre=${JAVA:-none}"

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        # 只看 kill -0 会把「PID 被复用给别的进程」当成还在运行 → 永远不启动 → 网关 502。
        # 必须确认这个 pid 的命令行里真的有 hub.Hub。
        if [ -n "$pid" ] && kill -0 "${pid}" 2>/dev/null; then
            cmd=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)
            case "$cmd" in
                *'hub.Hub'*|*'run-hub.sh'*) return 0 ;;
            esac
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    # 非正常退出后 socket 文件会残留，bind 必失败（靠 5 秒重启自愈太慢）
    [ -S "${SOCK}" ] && rm -f "${SOCK}"

    # 兜底回收重复实例：历史上 stop 只杀 java 不杀 supervisor，会越积越多，
    # 后启动的实例绑不到 8098 就顺延端口 → 网关连的是最老那个（跑旧代码）。
    dups=$(ps -eo pid,args | grep -E 'run-hub\.sh|hub\.Hub --port' | grep -v grep | awk '{print $1}')
    if [ -n "$dups" ]; then
        log_msg "清理残留实例: $(echo $dups | tr '\n' ' ')"
        kill -TERM $dups 2>/dev/null
        sleep 2
        kill -KILL $dups 2>/dev/null
        rm -f "${PID_FILE}"
    fi
    if status; then
        log_msg "already running (pid=$(cat "${PID_FILE}"))"
        return 0
    fi

    if [ -z "$JAVA" ] || [ ! -x "$JAVA" ]; then
        log_msg "ERROR: 找不到 java（内置 JRE 缺失，系统也没有）"
        return 1
    fi

    SPIDER_JAR="$(find "${APP}/ui/spiders" -maxdepth 1 -name '*.jar' 2>/dev/null | head -1)"
    log_msg "Starting (java=${JAVA}, spider=${SPIDER_JAR:-none})"

    # 交给 run-hub.sh 守护：
    #   · JVM 在 GC 段错误里崩过（G1SATBMarkQueueSet::filter），需要自动拉起
    #   · 启动参数在守护脚本里（SerialGC + ExitOnOutOfMemoryError，绕开 G1 那条路径）
    # run-hub.sh 和本脚本同目录：fnOS 里 cmd/ 在 /var/apps/<app>/cmd，
    # 而 APP(TRIM_APPDEST) 指的是 /vol3/@appcenter/<app>，两者不是一回事。
    SELF_DIR="$(cd "$(dirname "$0")" && pwd -P)"
    RUNNER="${SELF_DIR}/run-hub.sh"
    [ -f "$RUNNER" ] || RUNNER="${APP}/cmd/run-hub.sh"
    if [ ! -f "$RUNNER" ]; then
        log_msg "ERROR: 缺少 ${RUNNER}"
        return 1
    fi
    bash "$RUNNER" "$JAVA" "$APP" "${TRIM_PKGVAR}" "${LOG_FILE}" "$SPIDER_JAR" >> "${LOG_FILE}" 2>&1 &

    pid=$!
    printf "%s" "$pid" > "${PID_FILE}"
    log_msg "supervisor pid=$pid"

    # 等 socket 出现（最多 15 秒），确认真的起得来
    local count=0
    while [ ! -S "${SOCK}" ] && [ $count -lt 15 ]; do
        sleep 1
        count=$((count + 1))
        if ! kill -0 "$pid" 2>/dev/null; then
            log_msg "ERROR: 进程已退出，看上面的日志"
            rm -f "${PID_FILE}"
            return 1
        fi
    done
    if [ -S "${SOCK}" ]; then
        log_msg "socket ready after ${count}s"
    else
        log_msg "ERROR: 15 秒内 socket 未出现，启动失败"
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "send TERM to supervisor PID:${pid}"
            kill -TERM "${pid}" 2>/dev/null
            local count=0
            while kill -0 "${pid}" 2>/dev/null && [ $count -lt 12 ]; do
                sleep 1; count=$((count + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "send KILL to supervisor PID:${pid}"
                kill -KILL "${pid}" 2>/dev/null
            fi
            # supervisor 被打死时子 java 可能变孤儿，兜底再收一遍
            pkill -TERM -f "hub.Hub --port ${PORT}" 2>/dev/null || true
            sleep 1
            pkill -KILL -f "hub.Hub --port ${PORT}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}"
    fi
    rm -f "${SOCK}"
    return 0
}

case "$1" in
start)   start_process ;;
stop)    stop_process ;;
status)  if status; then exit 0; else exit 3; fi ;;
restart) stop_process; start_process ;;
*)       exit 1 ;;
esac
